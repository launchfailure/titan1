{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pragmaconflux/titan1/schemas/correlation-report-v1.0.schema.json",
  "title": "Titan Correlation Report v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject_analysis_id",
    "relationships"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "subject_analysis_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relationship_id",
          "left_analysis_id",
          "right_analysis_id",
          "score",
          "confidence",
          "evidence"
        ],
        "properties": {
          "relationship_id": {
            "type": "string",
            "minLength": 1
          },
          "left_analysis_id": {
            "type": "string",
            "minLength": 1
          },
          "right_analysis_id": {
            "type": "string",
            "minLength": 1
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "confidence": {
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "key",
                "weight",
                "references"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "references": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "analysis_id"
                    ],
                    "properties": {
                      "analysis_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "node_id": {
                        "type": "string"
                      },
                      "evidence_id": {
                        "type": "string"
                      },
                      "source": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
