{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pragmaconflux/titan1/schemas/titan-plugin-catalog-v1.0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "description", "plugins"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "description": {"type": "string", "minLength": 1},
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "api_version", "capabilities", "description", "publisher", "license", "source_url", "source_commit"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"},
          "name": {"type": "string", "minLength": 1},
          "version": {"type": "string"},
          "api_version": {"type": "string"},
          "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["decoder", "analyzer", "detection", "extractor", "report"]}},
          "description": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "license": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "pattern": "^https://"},
          "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    }
  }
}
